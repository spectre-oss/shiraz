<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/cluster_first" android:touchscreenBlocksFocus="true" android:layout_width="100px" android:layout_height="100px" android:keyboardNavigationCluster="true" android:nextClusterForward="@+id/cluster_second">
        <View android:layout_width="10px" android:layout_height="10px" android:focusable="true" android:focusedByDefault="true" />
    </LinearLayout>
    <LinearLayout android:id="@id/cluster_second" android:layout_width="100px" android:layout_height="100px" android:keyboardNavigationCluster="true">
        <View android:layout_width="10px" android:layout_height="10px" android:focusable="true" />
    </LinearLayout>
</FrameLayout>
