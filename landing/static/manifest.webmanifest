{
  "id": "./",
  "name": "Shiraz — Android™ apps on Linux, macOS, Windows and browser",
  "short_name": "Shiraz",
  "description": "Open-source, GTK-free Android™ compatibility layer, browser AppImage / Flatpak APK builder, and client-side WebAssembly APK runner.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#2b0f1c",
  "theme_color": "#2b0f1c",
  "categories": ["utilities", "developer"],
  "icons": [
    {
      "src": "spectre.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Run APK in browser",
      "short_name": "Run APK",
      "description": "Drop and run a supported Android™ APK locally in WebAssembly.",
      "url": "./run/?standalone=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./run/?standalone=1",
      "accept": {
        "application/vnd.android.package-archive": [".apk"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  }
}
