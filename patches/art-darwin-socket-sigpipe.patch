+// Socket-scoped suppression also covers pending SIGPIPE at thread teardown.
+// Do not change process signal dispositions owned by the embedding application.
+static bool configureSocketSigpipe(JNIEnv* env, int fd) {
+#if defined(__APPLE__)
+    int enabled = 1;
+    if (setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &enabled, sizeof(enabled)) == -1) {
+        throwErrnoException(env, "setsockopt(SO_NOSIGPIPE)");
+        return false;
+    }
+#endif
+    return true;
+}
+
 static jobject Linux_accept(JNIEnv* env, jobject, jobject javaFd, jobject javaSocketAddress) {
     sockaddr_storage ss;
     socklen_t sl = sizeof(ss);
@@ -997,6 +1010,10 @@
     sockaddr* peer = (javaSocketAddress != NULL) ? reinterpret_cast<sockaddr*>(&ss) : NULL;
     socklen_t* peerLength = (javaSocketAddress != NULL) ? &sl : 0;
     jint clientFd = NET_FAILURE_RETRY(env, int, accept, javaFd, peer, peerLength);
+    if (clientFd != -1 && !configureSocketSigpipe(env, clientFd)) {
+        close(clientFd);
+        return NULL;
+    }
 #if defined(__APPLE__)
