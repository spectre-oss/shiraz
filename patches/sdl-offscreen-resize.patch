     return 0;
 }
 
+/* Shiraz: recreate the pbuffer on resize while retaining the GL context. */
+void OFFSCREEN_SetWindowSize(_THIS, SDL_Window *window)
+{
+#ifdef SDL_VIDEO_OPENGL_EGL
+    OFFSCREEN_Window *data = window->driverdata;
+    EGLSurface replacement;
+    SDL_GLContext context;
+    SDL_bool current;
+    if (!data || data->egl_surface == EGL_NO_SURFACE) {
+        return;
+    }
+    replacement = SDL_EGL_CreateOffscreenSurface(_this, window->w, window->h);
+    if (replacement == EGL_NO_SURFACE) {
+        return;
+    }
+    current = SDL_GL_GetCurrentWindow() == window;
+    context = SDL_GL_GetCurrentContext();
+    if (current && SDL_EGL_MakeCurrent(_this, replacement, context) < 0) {
+        SDL_EGL_DestroySurface(_this, replacement);
+        return;
+    }
+    SDL_EGL_DestroySurface(_this, data->egl_surface);
+    data->egl_surface = replacement;
+#endif
+}
+
 void OFFSCREEN_DestroyWindow(_THIS, SDL_Window *window)
 {
     OFFSCREEN_Window *offscreen_window = window->driverdata;
