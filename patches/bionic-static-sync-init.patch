+// Serialize only first-use initialization. Construct privately before publishing:
+// another thread must never observe a half-initialized host synchronization object.
+static pthread_mutex_t static_init_mutex = PTHREAD_MUTEX_INITIALIZER;
+#define INIT_IF_NOT_MAPPED(x, init) do { \
+    if (!IS_MAPPED(x)) { \
+        pthread_mutex_lock(&static_init_mutex); \
+        if (!IS_MAPPED(x)) { \
+            __typeof__(*(x)) pending; \
+            memcpy(&pending, (x), sizeof(pending)); \
+            init(&pending); \
+            bionic_store_ptr((x), sizeof(*(x)), bionic_load_ptr(&pending, sizeof(pending))); \
+        } \
+        pthread_mutex_unlock(&static_init_mutex); \
+    } \
+} while (0)
 
