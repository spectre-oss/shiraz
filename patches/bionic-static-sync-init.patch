+// Bionic LP64 sync structs (pthread_mutex_t, pthread_cond_t, pthread_rwlock_t,
+// sem_t) are arrays of int32_t and have 4-byte ABI alignment. Android NDK .so
+// binaries routinely place them at 4 mod 8 addresses (e.g. libc++_shared.so
+// std::__ndk1::mut). On ARM64, 64-bit atomic load/store (LDAR/STLR) on a
+// 4-byte-aligned address faults with SIGBUS (BUS_ADRALN). Store the mapped
+// host pointer in the first pointer-aligned slot inside the struct (>= 16 B on
+// LP64, zero-initialized in all Bionic static initializers); fall back to a
+// leaf-locked memcpy only for smaller unaligned structs.
+typedef void *bionic_ptr_slot_t __attribute__((__may_alias__));
+static pthread_mutex_t unaligned_ptr_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static inline bionic_ptr_slot_t *bionic_aligned_slot(void *base, size_t total_size)
+{
+	uintptr_t addr = (uintptr_t)base;
+	if ((addr & (sizeof(void *) - 1)) == 0)
+		return (bionic_ptr_slot_t *)addr;
+	uintptr_t aligned = (addr + sizeof(void *) - 1) & ~(uintptr_t)(sizeof(void *) - 1);
+	if (aligned + sizeof(void *) <= addr + total_size)
+		return (bionic_ptr_slot_t *)aligned;
+	return NULL;
+}
+
+static inline void *bionic_load_ptr(const void *base, size_t total_size)
+{
+	bionic_ptr_slot_t *slot = bionic_aligned_slot((void *)(uintptr_t)base, total_size);
+	if (slot)
+		return __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+	void *ptr = NULL;
+	pthread_mutex_lock(&unaligned_ptr_mutex);
+	memcpy(&ptr, base, sizeof(ptr));
+	pthread_mutex_unlock(&unaligned_ptr_mutex);
+	return ptr;
+}
+
+static inline void bionic_store_ptr(void *base, size_t total_size, void *ptr)
+{
+	bionic_ptr_slot_t *slot = bionic_aligned_slot(base, total_size);
+	if (slot) {
+		__atomic_store_n(slot, ptr, __ATOMIC_RELEASE);
+		return;
+	}
+	pthread_mutex_lock(&unaligned_ptr_mutex);
+	memcpy(base, &ptr, sizeof(ptr));
+	pthread_mutex_unlock(&unaligned_ptr_mutex);
+}
