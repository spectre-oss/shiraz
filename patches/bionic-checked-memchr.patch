 }
+
+/* Android FORTIFY's checked memchr is not exported by glibc. */
+void *bionic___memchr_chk(const void *buffer, int value, size_t count, size_t capacity) {
+    if (count > capacity) {
+        fprintf(stderr, "FORTIFY: memchr exceeds buffer capacity\n");
+        abort();
+    }
+    return memchr(buffer, value, count);
+}
