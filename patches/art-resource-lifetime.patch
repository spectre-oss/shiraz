diff --git a/libandroidfw/androidfw_c_api.cpp b/libandroidfw/androidfw_c_api.cpp
index 3f3d9c56..7ab7edad 100644
--- a/libandroidfw/androidfw_c_api.cpp
+++ b/libandroidfw/androidfw_c_api.cpp
@@ -19,14 +19,33 @@ class GuardedAssetManager2 : public android::AssetManager2 {
 
 extern "C" const struct ApkAssets *ApkAssets_load(const char *path, bool system)
 {
-  const android::ApkAssets *apkAssets = android::ApkAssets::Load(path, system).release();
-  return reinterpret_cast<const struct ApkAssets *>(apkAssets);
+  auto apkAssets = android::ApkAssets::Load(path, system);
+  if (apkAssets) apkAssets->incStrong(apkAssets.get());
+  return reinterpret_cast<const struct ApkAssets *>(apkAssets.get());
 }
 
 extern "C" const struct ApkAssets *ApkAssets_loadDir(const char *path)
 {
-  const android::ApkAssets *apkAssets = android::ApkAssets::Load(android::DirectoryAssetsProvider::Create(path)).release();
-  return reinterpret_cast<const struct ApkAssets *>(apkAssets);
+  auto apkAssets = android::ApkAssets::Load(android::DirectoryAssetsProvider::Create(path));
+  if (apkAssets) apkAssets->incStrong(apkAssets.get());
+  return reinterpret_cast<const struct ApkAssets *>(apkAssets.get());
+}
+
+extern "C" void ApkAssets_delete(const struct ApkAssets *assets)
+{
+  auto apkAssets = reinterpret_cast<const android::ApkAssets *>(assets);
+  if (apkAssets) apkAssets->decStrong(apkAssets);
+}
+
+extern "C" void AssetManager_delete(struct AssetManager *manager)
+{
+  delete reinterpret_cast<GuardedAssetManager2 *>(manager);
+}
+
+extern "C" void ResTable_config_setLocale(struct ResTable_config *config, const char *locale)
+{
+  static_assert(sizeof(struct ResTable_config) == sizeof(android::ResTable_config));
+  reinterpret_cast<android::ResTable_config *>(config)->setBcp47Locale(locale);
 }
 
