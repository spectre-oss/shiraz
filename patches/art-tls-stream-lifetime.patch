      * entering library */
     final private Object ioLock = new Object();
 
+    /* Stream operations outlive the brief native I/O mutex lock (e.g. select).
+     * Closing must not free their WOLFSSL/session mutex until they return. */
+    private int activeStreamOperations;
+
+    private void retainStreamSession() throws SocketException {
+        synchronized (handshakeLock) {
+            if (connectionClosed || ssl == null) {
+                throw new SocketException("Connection already shutdown");
+            }
+            activeStreamOperations++;
+        }
+    }
+
+    private void releaseStreamSession() throws IOException {
+        synchronized (handshakeLock) {
+            activeStreamOperations--;
+            try { freeClosedSession(); }
+            catch (WolfSSLJNIException error) { throw new IOException(error); }
+        }
+    }
+
+    /* Caller holds handshakeLock. No blocking I/O is performed here. */
+    private void freeClosedSession() throws WolfSSLJNIException {
+        if (connectionClosed && activeStreamOperations == 0 && ssl != null) {
+            ssl.freeSSL();
+            ssl = null;
+        }
+    }
