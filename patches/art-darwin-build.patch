diff --git a/build/core/combo/HOST_darwin-arm64.mk b/build/core/combo/HOST_darwin-arm64.mk
new file mode 100644
index 0000000000000000000000000000000000000000..ded9e8f3572380b9d956d7b0ff56b080e05e5684
--- /dev/null
+++ b/build/core/combo/HOST_darwin-arm64.mk
@@ -0,0 +1,118 @@
+#
+# Copyright (C) 2006 The Android Open Source Project
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+
+# Configuration for native macOS on Apple Silicon (darwin-arm64), Shiraz port.
+# Included by combo/select.mk.
+#
+# WITHOUT_CLANG=true keeps the "gcc" rule path of this build system; HOST_CC
+# and HOST_CXX simply point at Apple clang from the active Xcode toolchain.
+# Libraries are Mach-O dylibs that keep the ".so" file name so that
+# System.loadLibrary (JNI_LIB_SUFFIX ".so") and the install rules are unchanged.
+# mac_version.mk is intentionally not included: it only knows x86 SDKs.
+
+mac_sdk_root := $(shell xcrun --sdk macosx --show-sdk-path)
+mac_sdk_version := 15.0
+
+HOST_CC  := $(shell xcrun -f clang)
+HOST_CXX := $(shell xcrun -f clang++)
+HOST_AR  := $(shell xcrun -f ar)
+
+HOST_GLOBAL_CFLAGS += -arch arm64 -isysroot $(mac_sdk_root) -mmacosx-version-min=$(mac_sdk_version)
+HOST_GLOBAL_CFLAGS += -fPIC -funwind-tables
+HOST_GLOBAL_CFLAGS += -Werror=unguarded-availability-new
+# Workaround differences in inttypes.h between host and target (bug 12708004).
+HOST_GLOBAL_CFLAGS += -D__STDC_FORMAT_MACROS -D__STDC_CONSTANT_MACROS
+# Expose the BSD/Darwin extensions even where a source defines _POSIX_C_SOURCE.
+HOST_GLOBAL_CFLAGS += -D_DARWIN_C_SOURCE
+HOST_GLOBAL_CFLAGS += -include $(call select-android-config-h,darwin-arm64)
+HOST_GLOBAL_CPPFLAGS += -stdlib=libc++
+HOST_GLOBAL_LDFLAGS += -arch arm64 -isysroot $(mac_sdk_root) -mmacosx-version-min=$(mac_sdk_version) -stdlib=libc++
+
+# In-tree third-party dependencies (ICU4C 78.x dylibs with @rpath install
+# names, static liblz4.a and liblzma.a) are installed into $(____PREFIX) by
+# Shiraz's bootstrap. zlib and expat come from the SDK (.tbd). Nothing is taken
+# from Homebrew. ____PREFIX is set by the top-level Makefile (default
+# /usr/local); Shiraz passes ____PREFIX=<repo>/.local.
+ifneq ($(strip $(____PREFIX)),)
+HOST_DARWIN_DEPS_PREFIX := $(____PREFIX)
+HOST_GLOBAL_CFLAGS += -isystem $(HOST_DARWIN_DEPS_PREFIX)/include
+HOST_GLOBAL_LD_DIRS += -L$(HOST_DARWIN_DEPS_PREFIX)/lib
+endif
+
+HOST_NO_UNDEFINED_LDFLAGS := -Wl,-undefined,error
+HOST_SHLIB_SUFFIX := .so
+HOST_JNILIB_SUFFIX := .so
+HOST_GLOBAL_ARFLAGS := crs
+
+# Linux-only libraries that some module makefiles still name. On Darwin their
+# functions live in libSystem (librt, libatomic), so they are dropped at link
+# time instead of failing with "library not found".
+HOST_DARWIN_DROPPED_LDLIBS := -lrt -latomic
+# ld64 ignores -pie (all arm64 Mach-O executables are PIE); clang warns about it.
+# ld64 rejects GNU -z options; -Wl,-z,defs is covered by HOST_NO_UNDEFINED_LDFLAGS
+# (-undefined error), which every Darwin link rule below passes.
+HOST_DARWIN_DROPPED_LDFLAGS := -pie -Wl,-z,defs
+# In-tree static dependencies from .local (no system copy on macOS). They are
+# linked with ld64 -hidden-l so a dylib does not re-export their symbols.
+HOST_DARWIN_HIDDEN_LDLIBS := -lpng
+
+# $(1): a module's LDLIBS, with Linux-only libraries dropped and in-tree static
+# dependencies linked hidden.
+define darwin-host-ldlibs
+$(foreach lib,$(filter-out $(HOST_DARWIN_DROPPED_LDLIBS),$(1)),$(if $(filter $(lib),$(HOST_DARWIN_HIDDEN_LDLIBS)),-Wl$(comma)-hidden$(lib),$(lib)))
+endef
+
+HOST_CUSTOM_LD_COMMAND := true
+
+# Dylibs: install name @rpath/<file>, find sibling dylibs via @loader_path.
+define transform-host-o-to-shared-lib-inner
+$(hide) $(PRIVATE_CXX) \
+        -dynamiclib \
+        -install_name @rpath/$(notdir $@) \
+        -Wl,-headerpad_max_install_names \
+        $(HOST_NO_UNDEFINED_LDFLAGS) \
+        $(HOST_GLOBAL_LD_DIRS) \
+        $(if $(PRIVATE_NO_DEFAULT_COMPILER_FLAGS),, $(PRIVATE_HOST_GLOBAL_LDFLAGS)) \
+        $(PRIVATE_ALL_OBJECTS) \
+        $(addprefix -Wl$(comma)-force_load$(comma), $(PRIVATE_ALL_WHOLE_STATIC_LIBRARIES)) \
+        $(call normalize-host-libraries,$(PRIVATE_ALL_STATIC_LIBRARIES)) \
+        $(call normalize-host-libraries,$(PRIVATE_ALL_SHARED_LIBRARIES)) \
+        $(call darwin-host-ldlibs,$(PRIVATE_LDLIBS)) \
+        -o $@ \
+        -Wl,-rpath,@loader_path \
+        $(filter-out $(HOST_DARWIN_DROPPED_LDFLAGS),$(PRIVATE_LDFLAGS))
+endef
+
+# Executables in <root>/bin find their dylibs in <root>/lib64.
+define transform-host-o-to-executable-inner
+$(hide) $(PRIVATE_CXX) \
+        -Wl,-rpath,@loader_path/../lib64 \
+        -Wl,-headerpad_max_install_names \
+        $(HOST_NO_UNDEFINED_LDFLAGS) \
+        -o $@ \
+        $(HOST_GLOBAL_LD_DIRS) \
+        $(if $(PRIVATE_NO_DEFAULT_COMPILER_FLAGS),, $(PRIVATE_HOST_GLOBAL_LDFLAGS)) \
+        $(PRIVATE_ALL_OBJECTS) \
+        $(addprefix -Wl$(comma)-force_load$(comma), $(PRIVATE_ALL_WHOLE_STATIC_LIBRARIES)) \
+        $(call normalize-host-libraries,$(PRIVATE_ALL_STATIC_LIBRARIES)) \
+        $(call normalize-host-libraries,$(PRIVATE_ALL_SHARED_LIBRARIES)) \
+        $(filter-out $(HOST_DARWIN_DROPPED_LDFLAGS),$(PRIVATE_LDFLAGS)) \
+        $(call darwin-host-ldlibs,$(PRIVATE_LDLIBS))
+endef
+
+define get-file-size
+stat -f "%z" $(1)
+endef
diff --git a/build/core/combo/include/arch/darwin-arm64/AndroidConfig.h b/build/core/combo/include/arch/darwin-arm64/AndroidConfig.h
new file mode 100644
index 0000000000000000000000000000000000000000..7ab5ebedb28aebbca67e6a05301137d41304b8fe
--- /dev/null
+++ b/build/core/combo/include/arch/darwin-arm64/AndroidConfig.h
@@ -0,0 +1,62 @@
+/*
+ * Copyright (C) 2005 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Android config -- "Darwin arm64".  Used for native macOS on Apple Silicon
+ * (Shiraz port). Derived from linux-any/AndroidConfig.h: macOS has
+ * <sys/uio.h> and pthreads, but no <malloc.h>, no off64_t and no LFS64
+ * interfaces (off_t is always 64 bits).
+ */
+#ifndef _ANDROID_CONFIG_H
+#define _ANDROID_CONFIG_H
+
+/*
+ * ===========================================================================
+ *                              !!! IMPORTANT !!!
+ * ===========================================================================
+ *
+ * This file is included by ALL C/C++ source files.  Don't put anything in
+ * here unless you are absolutely certain it can't go anywhere else.
+ *
+ * Any C++ stuff must be wrapped with "#ifdef __cplusplus".  Do not use "//"
+ * comments.
+ */
+
+/* <sys/uio.h> provides struct iovec, readv and writev. */
+#define HAVE_SYS_UIO_H 1
+
+#define HAVE_PTHREADS 1
+
+/*
+ * off_t is 64 bits on macOS; there is no off64_t and no _LARGEFILE64_SOURCE.
+ * HAVE_OFF64_T is therefore left undefined.
+ */
+#define _FILE_OFFSET_BITS 64
+#define _LARGEFILE_SOURCE 1
+
+/* There is no <malloc.h> on macOS (use <malloc/malloc.h>). HAVE_MALLOC_H is undefined. */
+
+/*
+ * The default path separator for the platform
+ */
+#define OS_PATH_SEPARATOR '/'
+
+/*
+ * Define if <stdint.h> exists.
+ */
+#define HAVE_STDINT_H 1
+
+#endif /*_ANDROID_CONFIG_H*/
