diff --git a/libcore/NativeCode.mk b/libcore/NativeCode.mk
index cf2ecd23c760698f7b69bf94d62140baff1d1db5..db6b13ba27d863e76f2b80671303e50cb2c6e806 100644
--- a/libcore/NativeCode.mk
+++ b/libcore/NativeCode.mk
@@ -102,7 +102,33 @@ core_test_files := \
 # Build for the host.
 #
 
-ifeq ($(HOST_OS),linux)
+ifneq (,$(filter linux darwin,$(HOST_OS)))
+
+ifeq ($(HOST_OS),darwin)
+# Darwin (macOS) host. ICU4C comes from the in-tree build installed under
+# $(____PREFIX), never from the system libicucore (its C++ ABI differs from
+# upstream) or Homebrew. ICU is linked into libjavacore only; libopenjdk
+# (Character.cpp) resolves its ICU symbols through libjavacore so one copy of
+# ICU state and data exists in the process, and only that copy is initialised
+# by libjavacore's JNI_OnLoad (udata_setFileAccess/u_init).
+darwin_icu_libdir := $(____PREFIX)/$(____LIBDIR)
+darwin_icu_cflags := -isystem $(____PREFIX)/include
+SHIRAZ_ICU_LINKAGE ?= $(if $(wildcard $(darwin_icu_libdir)/libicuuc.dylib),shared,static)
+ifeq ($(SHIRAZ_ICU_LINKAGE),shared)
+darwin_icu_javacore_ldlibs := -L$(darwin_icu_libdir) -licui18n -licuuc
+darwin_icu_openjdk_ldlibs := -L$(darwin_icu_libdir) -licuuc
+else
+# Static ICU: force-load common and i18n so every ICU entry point is exported
+# from libjavacore (libopenjdk binds to it), plus the static data archive.
+darwin_icu_javacore_ldlibs := \
+    -Wl,-force_load,$(darwin_icu_libdir)/libicui18n.a \
+    -Wl,-force_load,$(darwin_icu_libdir)/libicuuc.a \
+    $(darwin_icu_libdir)/libicudata.a
+darwin_icu_openjdk_ldlibs :=
+endif
+# OpenJDK's own BSD/macOS configuration instead of the glibc one.
+darwin_openjdk_cflags := -D_ALLBSD_SOURCE -DMACOSX -D_DARWIN_C_SOURCE -D__LITTLE_ENDIAN
+endif
 
 include $(CLEAR_VARS)
 LOCAL_CLANG := true
@@ -110,7 +136,12 @@ LOCAL_SRC_FILES += $(core_src_files)
 LOCAL_CFLAGS += $(libart_cflags)
 LOCAL_C_INCLUDES += $(core_c_includes)
 LOCAL_CPPFLAGS += $(core_cppflags)
+ifeq ($(HOST_OS),darwin)
+LOCAL_CFLAGS += $(darwin_icu_cflags)
+LOCAL_LDLIBS += -lz -lexpat $(darwin_icu_javacore_ldlibs)
+else
 LOCAL_LDLIBS += -ldl -lpthread -lexpat -lz -licuuc -licui18n
+endif
 ifeq ($(HOST_OS),linux)
 LOCAL_LDLIBS += -lrt
 endif
@@ -123,6 +154,8 @@ LOCAL_MULTILIB := both
 include $(BUILD_HOST_SHARED_LIBRARY)
 
 # Debug version of libopenjdk (host). Depends on libopenjdkjvmd.
+# Not built on Darwin: the macOS port is release-only (no libartd/libopenjdkjvmd).
+ifneq ($(HOST_OS),darwin)
 include $(CLEAR_VARS)
