diff --git a/art/build/Android.common_build.mk b/art/build/Android.common_build.mk
index 3cb740294fe4ae7358ef33c639adaf21442dc375..c26f18ab68de9d9d578828ad651ab3eb820a7676 100644
--- a/art/build/Android.common_build.mk
+++ b/art/build/Android.common_build.mk
@@ -196,6 +196,20 @@ ifneq ($(C_INCLUDE_PATH),)
   art_cflags += -I$(C_INCLUDE_PATH)/vixl
 endif
 
+# Native macOS on Apple Silicon (Shiraz darwin-arm64 port).
+ifeq ($(HOST_OS)-$(HOST_ARCH),darwin-arm64)
+  # 16 KiB pages: every stack overflow gap must be a multiple of kPageSize, and
+  # instruction_set.cc static_asserts all of them, not only the host ISA's.
+  art_cflags := $(filter-out -DART_STACK_OVERFLOW_GAP_%,$(art_cflags))
+  art_cflags += -DART_STACK_OVERFLOW_GAP_arm=16384 -DART_STACK_OVERFLOW_GAP_arm64=16384 \
+    -DART_STACK_OVERFLOW_GAP_mips=16384 -DART_STACK_OVERFLOW_GAP_mips64=16384 \
+    -DART_STACK_OVERFLOW_GAP_x86=16384 -DART_STACK_OVERFLOW_GAP_x86_64=16384
+  # Only the C++ switch interpreter runs; mterp is assembled and linked but never entered.
+  art_cflags += -DART_USE_CXX_INTERPRETER=1
+  # Vendored musl <elf.h> (MIT, see art/darwin/include/LICENSE.musl); the SDK has none.
+  art_cflags += -Iart/darwin/include
+endif
+
 # The architectures the compiled tools are able to run on. Setting this to 'all' will cause all
 # architectures to be included.
 ART_HOST_CODEGEN_ARCHS ?= $(HOST_ARCH)
diff --git a/art/dalvikvm/Android.mk b/art/dalvikvm/Android.mk
index 3f20e405a84380a940201d1eca461c5e48ad9e99..a96117ecc5b909bff90a18abf1ba799a3db4bff2 100644
--- a/art/dalvikvm/Android.mk
+++ b/art/dalvikvm/Android.mk
@@ -9,10 +9,30 @@ LOCAL_CFLAGS   =  \
         $(ART_HOST_CFLAGS) \
         -Wall \
         -Wextra
+ifeq ($(HOST_OS),darwin)
+LOCAL_LDFLAGS  = -Wl,-export_dynamic
+else
 LOCAL_LDFLAGS  = -Wl,--export-dynamic
+endif
 LOCAL_SRC_FILES = dalvikvm.cc
 LOCAL_SHARED_LIBRARIES = libnativehelper
+ifeq ($(HOST_OS),darwin)
+# Darwin: one libsigchain only, the dylib that libart links, so that there is
+# a single chain state (a copy whole-linked into dalvikvm would keep a second,
+# separate one). Note that libsigchain's sigaction/signal/sigprocmask
+# interposition is inert on Darwin: with two-level namespaces a plain
+# sigaction()/signal() call, in libart or in a JNI/host library, binds to
+# libSystem, not to libsigchain. Only explicit sigchain_* callers (e.g.
+# sigchain_sigaction in InitPlatformSignalHandlers, AddSpecialSignalHandlerFn)
+# go through the chain, and a library that installs its own SIGSEGV/SIGBUS
+# handler replaces ART's instead of being chained behind it. That is harmless
+# while the fault manager is off on Darwin; enabling it needs DYLD_INTERPOSE
+# entries (resolving the real functions from libSystem, not RTLD_NEXT) or
+# explicit sigchain_* routing first.
+LOCAL_SHARED_LIBRARIES += libsigchain
+else
 LOCAL_WHOLE_STATIC_LIBRARIES = libsigchain
+endif
 LOCAL_C_INCLUDES = $(ART_C_INCLUDES)
 LOCAL_CPP_EXTENSION = .cc
 include $(BUILD_HOST_EXECUTABLE)
