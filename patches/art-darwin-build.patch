diff --git a/external/fdlibm/Android.mk b/external/fdlibm/Android.mk
index 9e84bc3a3ccbed7c810daa114c65b72ed8fce0c8..deb42979574ff53639a459dfd21f212b62d58269 100644
--- a/external/fdlibm/Android.mk
+++ b/external/fdlibm/Android.mk
@@ -88,6 +88,15 @@ ifeq ($(WITH_HOST_DALVIK),true)
         # See similar section above.
         LOCAL_CFLAGS += "-D__LITTLE_ENDIAN"
     endif
+    ifeq ($(HOST_OS),darwin)
+        # macOS hosts are little-endian (arm64; HOST_ARCH is arm64 there).
+        # Without this fdlibm reads the wrong double halves and StrictMath
+        # returns wrong results.
+        LOCAL_CFLAGS += "-D__LITTLE_ENDIAN"
+        # clang contracts a*b+c into fused multiply-adds on arm64 by default,
+        # which changes results; StrictMath needs plain IEEE operations.
+        LOCAL_CFLAGS += -ffp-contract=off
+    endif
 
