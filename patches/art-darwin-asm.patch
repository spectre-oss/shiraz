+#if defined(__APPLE__)
+// Mach-O (darwin-arm64). C symbols carry a leading underscore, there is no
+// .type/.size, and .private_extern replaces .hidden. On arm64 Mach-O every
+// non-temporary label starts a new atom and the assembler cannot resolve a
+// CFI advance across atoms, so labels inside a function must be
+// assembler-temporary, which on Mach-O means an "L" prefix (see L() below).
+#define SYMBOL(name) _ ## name
+#define ASM_HIDDEN .private_extern
+// Function-local label: assembler-temporary on both object formats.
+#define L(name) L ## name
+// Unprefixed asm-to-C references resolve through `.set name, _name`.
+#include "arch/arm64/darwin_symbol_aliases.S"
+
+.macro ENTRY name
+    .private_extern _\name  // Hide this as a global symbol, so we do not incur stub calls.
+    .globl _\name
+    /* Cache alignment for function entry */
+    .balign 16
+_\name:
+\name:  // Unprefixed local alias at the same address for intra-asm references.
+    .cfi_startproc
+.endm
+
+.macro END name
+    .cfi_endproc
+.endm
+#else
+#define SYMBOL(name) name
+#define ASM_HIDDEN .hidden
+// Function-local label: assembler-temporary on both object formats.
+#define L(name) .L ## name
+
 .macro ENTRY name
     .type \name, #function
     .hidden \name  // Hide this as a global symbol, so we do not incur plt calls.
@@ -54,6 +86,7 @@
     .cfi_endproc
     .size \name, .-\name
 .endm
+#endif  // defined(__APPLE__)
 
 .macro UNIMPLEMENTED name
     ENTRY \name
