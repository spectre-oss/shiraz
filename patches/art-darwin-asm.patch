--- a/art/runtime/arch/arm64/memcmp16_arm64.S
+++ b/art/runtime/arch/arm64/memcmp16_arm64.S
@@ -48,32 +48,32 @@
 //          art_quick_string_compareto, which relies on these temps being unused.
 
 ENTRY __memcmp16
-  cbz     limit, .Lret0
+  cbz     limit, L(ret0)
   lsl     limit, limit, #1  /* Half-words to bytes.  */
   eor     tmp1, src1, src2
   tst     tmp1, #7
-  b.ne    .Lmisaligned8
+  b.ne    L(misaligned8)
   ands    tmp1, src1, #7
-  b.ne    .Lmutual_align
+  b.ne    L(mutual_align)
   add     limit_wd, limit, #7
   lsr     limit_wd, limit_wd, #3
   /* Start of performance-critical section  -- one 64B cache line.  */
-.Lloop_aligned:
+L(loop_aligned):
   ldr     data1, [src1], #8
   ldr     data2, [src2], #8
-.Lstart_realigned:
+L(start_realigned):
   subs    limit_wd, limit_wd, #1
   eor     diff, data1, data2  /* Non-zero if differences found.  */
   csinv   endloop, diff, xzr, ne  /* Last Dword or differences.  */
-  cbz     endloop, .Lloop_aligned
+  cbz     endloop, L(loop_aligned)
   /* End of performance-critical section  -- one 64B cache line.  */
 
   /* Not reached the limit, must have found a diff.  */
-  cbnz    limit_wd, .Lnot_limit
+  cbnz    limit_wd, L(not_limit)
 
   /* Limit % 8 == 0 => all bytes significant.  */
   ands    limit, limit, #7
-  b.eq    .Lnot_limit
+  b.eq    L(not_limit)
 
   lsl     limit, limit, #3  /* Bits -> bytes.  */
   mov     mask, #~0
@@ -81,7 +81,7 @@ ENTRY __memcmp16
   bic     data1, data1, mask
   bic     data2, data2, mask
 
-.Lnot_limit:
+L(not_limit):
 
   // Swap the byte order of diff. Exact reverse is not important, as we only need to detect
   // the half-word.
@@ -102,7 +102,7 @@ ENTRY __memcmp16
   sub     result, data1, data2
   ret
 
-.Lmutual_align:
+L(mutual_align):
   /* Sources are mutually aligned, but are not currently at an
      alignment boundary.  Round down the addresses and then mask off
      the bytes that precede the start point.  */
@@ -120,14 +120,14 @@ ENTRY __memcmp16
   orr     data1, data1, tmp2
   orr     data2, data2, tmp2
   lsr     limit_wd, limit_wd, #3
-  b       .Lstart_realigned
+  b       L(start_realigned)
 
-.Lret0:
+L(ret0):
   mov     result, #0
   ret
 
   .p2align 6
-.Lmisaligned8:
+L(misaligned8):
   sub     limit, limit, #1
 1:
   /* Perhaps we can do better than this.  */
