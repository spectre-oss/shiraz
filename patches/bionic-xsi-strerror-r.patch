diff --git a/libc/libc-misc.c b/libc/libc-misc.c
index c46c010..b5b10f3 100644
--- a/libc/libc-misc.c
+++ b/libc/libc-misc.c
@@ -101,3 +101,18 @@ char* bionic___gnu_strerror_r(int error_number, char* buf, size_t buf_len) {
 	return buf;
 #endif
 }
+
+#ifdef __GLIBC__
+extern int __xpg_strerror_r(int, char*, size_t);
+#endif
+
+int bionic_strerror_r(int error_number, char* buf, size_t buf_len) {
+#ifdef __GLIBC__
+	return __xpg_strerror_r(error_number, buf, buf_len);
+#else
+	int saved_errno = errno;
+	int result = strerror_r(error_number, buf, buf_len);
+	errno = saved_errno;
+	return result;
+#endif
+}
