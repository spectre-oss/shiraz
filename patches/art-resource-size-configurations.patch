@@ -550,3 +550,21 @@

   return ret.has_value() ? true : false;
 }
+
+// Host size buckets use app qualifiers only, including mipmaps as Android API 27 does.
+extern "C" bool AssetManager_getSizeConfigurations(struct AssetManager *asset_manager,
+                                                  uint16_t *triples, size_t capacity,
+                                                  size_t *out_count) {
+  if (!asset_manager || !triples || !out_count) return false;
+  auto manager = reinterpret_cast<GuardedAssetManager2 *>(asset_manager);
+  auto configurations = manager->GetResourceConfigurations(true, false);
+  if (!configurations.has_value() || configurations->size() > capacity) return false;
+  size_t index = 0;
+  for (const auto& config : configurations.value()) {
+    triples[index++] = config.screenWidthDp;
+    triples[index++] = config.screenHeightDp;
+    triples[index++] = config.smallestScreenWidthDp;
+  }
+  *out_count = configurations->size();
+  return true;
+}
