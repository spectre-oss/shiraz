+#elif defined(__APPLE__)
+  // Darwin: a monotonic clock, not gettimeofday. A wall-clock step would make unsigned
+  // elapsed-time math (e.g. ThreadList::SuspendThreadByPeer) wrap and abort the runtime.
+  // CLOCK_UPTIME_RAW is mach_absolute_time: like Linux CLOCK_MONOTONIC it stops during
+  // sleep, and it is the timebase of the futex shim (OS_CLOCK_MACH_ABSOLUTE_TIME).
