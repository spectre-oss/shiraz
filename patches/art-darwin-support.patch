@@ -218,6 +234,11 @@ void InitTimeSpec(bool absolute, int clock, int64_t ms, int32_t ns, timespec* ts
   if (absolute) {
 #if defined(__linux__)
     clock_gettime(clock, ts);
+#elif defined(__APPLE__)
+    // Darwin: CLOCK_MONOTONIC counts time asleep there, unlike Linux. Map it to
+    // CLOCK_UPTIME_RAW so absolute monotonic deadlines share the timebase of NanoTime()
