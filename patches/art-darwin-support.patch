   return static_cast<uint64_t>(now.tv_sec) * UINT64_C(1000000) + now.tv_nsec / UINT64_C(1000);
+#elif defined(__APPLE__)
+  timespec now;
+  clock_gettime(CLOCK_UPTIME_RAW, &now);  // Darwin: see MilliTime().
+  return static_cast<uint64_t>(now.tv_sec) * UINT64_C(1000000) + now.tv_nsec / UINT64_C(1000);
 #else
