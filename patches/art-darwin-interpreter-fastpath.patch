+  // Shiraz: thread-local InterpreterCache fast path for field access, with mterp's cache
+  // contract (instance: raw offset, static: ArtField*, non-volatile fields only). It is used
+  // only without access checks, transactions or field listeners. Returns 1 when the access
+  // is done, -1 when resolution threw (exception pending) and 0 to let the stock handler
+  // perform the access, which also does every null check. A miss resolves the field like
+  // DoFieldGet/DoFieldPut and caches it (static fields only once their class is initialized).
+  template <bool kRead>
+  ALWAYS_INLINE bool UseFieldFastPath() const REQUIRES_SHARED(Locks::mutator_lock_) {
+    return !do_access_check && !transaction_active &&
+        !(kRead ? instrumentation->HasFieldReadListeners()
+                : instrumentation->HasFieldWriteListeners());
+  }
+
+  template <typename PrimType, FindFieldType kAccessType>
+  ALWAYS_INLINE int CachedFieldAccess() REQUIRES_SHARED(Locks::mutator_lock_) {
+    constexpr bool kIsStatic = (kAccessType & FindFieldFlags::StaticBit) != 0;
+    constexpr bool kIsPrimitive = (kAccessType & FindFieldFlags::PrimitiveBit) != 0;
+    constexpr bool kIsRead = (kAccessType & FindFieldFlags::ReadBit) != 0;
+    InterpreterCache* tls_cache = self->GetInterpreterCache();
+    size_t tls_value;
+    if (UNLIKELY(!tls_cache->Get(inst, &tls_value))) {
+      uint32_t field_idx = kIsStatic ? inst->VRegB_21c() : inst->VRegC_22c();
+      ArtField* field = FindFieldFromCode<kAccessType, /* access_checks= */ false>(
+          field_idx, shadow_frame.GetMethod(), self, sizeof(PrimType));
+      if (UNLIKELY(field == nullptr)) {
+        DCHECK(self->IsExceptionPending());
+        return -1;
+      }
+      if (!field->IsVolatile() && (!kIsStatic || field->GetDeclaringClass()->IsInitialized())) {
+        tls_cache->Set(inst, kIsStatic ? reinterpret_cast<size_t>(field)
+                                       : field->GetOffset().SizeValue());
+      }
+      return 0;
+    }
+    ObjPtr<mirror::Object> obj = kIsStatic
+        ? ObjPtr<mirror::Object>(reinterpret_cast<ArtField*>(tls_value)->GetDeclaringClass())
+        : shadow_frame.GetVRegReference(inst->VRegB_22c(inst_data));
+    if (UNLIKELY(obj == nullptr)) {
+      return 0;
+    }
+    MemberOffset offset(kIsStatic ? reinterpret_cast<ArtField*>(tls_value)->GetOffset().SizeValue()
+                                  : tls_value);
+    uint16_t vregA = kIsStatic ? inst->VRegA_21c(inst_data) : inst->VRegA_22c(inst_data);
+    if (kIsPrimitive) {
+      if (kIsRead) {
+        PrimType value = obj->GetFieldPrimitive<PrimType, /*kIsVolatile=*/ false>(offset);
+        if (sizeof(PrimType) == sizeof(uint64_t)) {
+          shadow_frame.SetVRegLong(vregA, value);
+        } else {
+          shadow_frame.SetVReg(vregA, static_cast<int32_t>(value));  // Sign/zero extend.
+        }
+      } else {
+        uint64_t value = (sizeof(PrimType) == sizeof(uint64_t)) ? shadow_frame.GetVRegLong(vregA)
+                                                                : shadow_frame.GetVReg(vregA);
+        obj->SetFieldPrimitive<PrimType, /*kIsVolatile=*/ false>(offset, value);
+      }
+    } else if (kIsRead) {
+      shadow_frame.SetVRegReference(vregA, obj->GetFieldObject<mirror::Object>(offset));
+    } else {
+      obj->SetFieldObject</*kTransactionActive=*/ false>(offset,
+                                                          shadow_frame.GetVRegReference(vregA));
+    }
+    return 1;
+  }
+
   ALWAYS_INLINE void IGET_BOOLEAN() REQUIRES_SHARED(Locks::mutator_lock_) {
-    bool success = DoFieldGet<InstancePrimitiveRead, Primitive::kPrimBoolean, do_access_check>(
