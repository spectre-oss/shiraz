+#ifndef DARWIN_SOCKOPT_SENTINELS_H_included
+#define DARWIN_SOCKOPT_SENTINELS_H_included
+
+#if !defined(__APPLE__)
+#error "DarwinSockoptSentinels.h is Darwin-only"
+#endif
+
+// Darwin has no SO_DOMAIN, SO_PROTOCOL or IP_MULTICAST_ALL, but libcore Java
+// uses them unconditionally (BlockGuardOs.isInetSocket on every accept(),
+// PlainDatagramSocketImpl.datagramSocketCreate on every DatagramSocket).
+// android_system_OsConstants.cpp exports these private sentinel option names
+// instead of 0, and Linux_getsockoptInt/Linux_setsockoptInt in
+// libcore_io_Linux.cpp emulate them. The values are far above every real
+// Darwin SOL_SOCKET (<= 0x1200) and IPPROTO_IP option, so if one ever reaches
+// the kernel through another path it fails with ENOPROTOOPT instead of
+// aliasing a real option.
+#define SHIRAZ_DARWIN_SO_DOMAIN         0x7f000001
+#define SHIRAZ_DARWIN_SO_PROTOCOL       0x7f000002
+#define SHIRAZ_DARWIN_IP_MULTICAST_ALL  0x7f000003
+
+#endif  // DARWIN_SOCKOPT_SENTINELS_H_included
