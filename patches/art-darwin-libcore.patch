+  return strlen(buf);
+#elif defined(__APPLE__)
+  if (len == 0) {
+    return 0;
+  }
+
+  // Darwin has the XSI strerror_r (int result). On ERANGE it leaves a truncated
+  // message and on EINVAL it writes "Unknown error: N", so buf is usable either way.
