index 0000000000000000000000000000000000000000..0d88cb1505eac36eb95e8819c6acaa04a8d63864
--- /dev/null
+++ b/libcore/luni/src/main/native/Portability_darwin.h
@@ -0,0 +1,270 @@
+/*
+ * Copyright (C) 2026 The Shiraz Authors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// Darwin (macOS) host compatibility for the libcore natives that were written
+// against glibc/bionic (libcore_io_Linux.cpp, libcore_io_Memory.cpp,
+// android_system_OsConstants.cpp). Included only from Portability.h and only
+// when __APPLE__ is defined.
+//
+// Rules followed here:
+//  - Where Darwin has an equivalent, map to it (LFS names, byte swapping).
+//  - Where a Linux facility can be emulated faithfully from user space, do so
+//    (sendfile(2) file-to-anything copies, pipe2(2), posix_fallocate(3)).
+//  - Where it cannot (capabilities, most prctl options), fail explicitly with
+//    ENOSYS so the Java caller sees an ErrnoException, never a silent success.
+
+#ifndef PORTABILITY_DARWIN_H_included
+#define PORTABILITY_DARWIN_H_included
+
+#if !defined(__APPLE__)
+#error "Portability_darwin.h is only for Darwin hosts"
+#endif
+
+// System headers first: the LFS macros below must not rename anything that
+// the SDK headers declare.
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/uio.h>
+#include <sys/xattr.h>
+#include <unistd.h>
+
+// <byteswap.h>
+#define bswap_16(x) __builtin_bswap16(x)
+#define bswap_32(x) __builtin_bswap32(x)
+#define bswap_64(x) __builtin_bswap64(x)
+
+// Large-file-support names. off_t, struct stat and struct flock are already
+// 64-bit on Darwin, so the *64 variants are the plain calls.
+#define off64_t off_t
+#define stat64 stat
+#define lstat64 lstat
+#define fstat64 fstat
+#define flock64 flock
+#define lseek64 lseek
+#define pread64 pread
+#define pwrite64 pwrite
+#define mmap64 mmap
+#define ftruncate64 ftruncate
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Exported by libsystem_kernel but not declared in the SDK headers.
+int fdatasync(int fd);
+#ifdef __cplusplus
+}
+#endif
+
+// posix_fallocate(3): returns an error number, like the real one.
+static inline int posix_fallocate64(int fd, off_t offset, off_t length) {
+    if (offset < 0 || length <= 0) {
+        return EINVAL;
+    }
+    if (offset > INT64_MAX - length) {
+        return EFBIG;
+    }
+    struct stat sb;
+    if (fstat(fd, &sb) == -1) {
+        return errno;
+    }
+    off_t end = offset + length;
+    if (end <= sb.st_size) {
+        return 0;
+    }
+    fstore_t store;
+    memset(&store, 0, sizeof(store));
+    store.fst_flags = F_ALLOCATECONTIG | F_ALLOCATEALL;
+    store.fst_posmode = F_PEOFPOSMODE;
+    store.fst_offset = 0;
+    store.fst_length = end - sb.st_size;
+    if (fcntl(fd, F_PREALLOCATE, &store) == -1) {
+        store.fst_flags = F_ALLOCATEALL;  // Retry without the contiguity request.
+        if (fcntl(fd, F_PREALLOCATE, &store) == -1) {
+            return errno;
+        }
+    }
+    if (ftruncate(fd, end) == -1) {
+        return errno;
+    }
+    return 0;
+}
+
+// Linux sendfile(2): copy up to count bytes from in_fd to out_fd. Darwin's
+// sendfile(2) only sends a file to a socket and has another signature, so the
+// copy is done in user space. With a non-NULL offset, in_fd is read with
+// pread() from *offset (its file position is unchanged) and *offset advances;
+// otherwise in_fd is read from, and advances, its file position. Returns the
+// number of bytes written, or -1 with errno set if nothing could be copied.
+static inline ssize_t shiraz_darwin_sendfile(int out_fd, int in_fd, off_t* offset, size_t count) {
+    char buf[64 * 1024];
+    size_t total = 0;
+    while (total < count) {
+        size_t chunk = count - total;
+        if (chunk > sizeof(buf)) {
+            chunk = sizeof(buf);
+        }
+        ssize_t n = (offset != NULL) ? pread(in_fd, buf, chunk, *offset) : read(in_fd, buf, chunk);
+        if (n == -1) {
+            if (total == 0) {
+                return -1;  // Includes EINTR: the caller's TEMP_FAILURE_RETRY restarts.
+            }
+            break;
+        }
+        if (n == 0) {
+            break;  // EOF.
+        }
+        ssize_t written = 0;
+        while (written < n) {
+            ssize_t w = write(out_fd, buf + written, n - written);
+            if (w == -1) {
+                if (errno == EINTR) {
+                    continue;
+                }
+                if (total == 0 && written == 0) {
+                    return -1;
+                }
+                // Report what was written; the data already read but not
+                // written is not consumed from the offset.
+                if (offset != NULL) {
+                    *offset += written;
+                } else if (n > written) {
+                    lseek(in_fd, -(off_t)(n - written), SEEK_CUR);
+                }
+                return (ssize_t)(total + written);
+            }
+            written += w;
+        }
+        total += (size_t)n;
+        if (offset != NULL) {
+            *offset += n;
+        }
+    }
+    return (ssize_t)total;
+}
+#define sendfile shiraz_darwin_sendfile
+
+// pipe2(2) is only in macOS 27+; emulate it for the macOS 15 baseline. The
+// two fds are not created atomically with O_CLOEXEC (no fork can race this in
+// the single ART process at the point libcore calls it, but note it anyway).
+static inline int shiraz_darwin_pipe2(int fds[2], int flags) {
+    if ((flags & ~(O_CLOEXEC | O_NONBLOCK)) != 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (pipe(fds) == -1) {
+        return -1;
+    }
+    for (int i = 0; i < 2; ++i) {
+        if (((flags & O_CLOEXEC) != 0 && fcntl(fds[i], F_SETFD, FD_CLOEXEC) == -1) ||
+            ((flags & O_NONBLOCK) != 0 &&
+             fcntl(fds[i], F_SETFL, fcntl(fds[i], F_GETFL) | O_NONBLOCK) == -1)) {
+            int saved_errno = errno;
+            close(fds[0]);
+            close(fds[1]);
+            errno = saved_errno;
+            return -1;
+        }
+    }
+    return 0;
+}
+#define pipe2 shiraz_darwin_pipe2
+
+// prctl(2). The only caller is Linux_prctl, i.e. android.system.Os.prctl, whose
+// arguments are Java longs. OsConstants exports no PR_SET_NAME (only
+// PR_GET_DUMPABLE, which Darwin lacks, so it stays unset). For PR_SET_NAME
+// (Linux value 15) Linux copies the name from the user pointer in arg2 and
+// returns EFAULT when that address is unreadable. A Java long is never a
+// readable C string pointer, and user space cannot validate an arbitrary
+// address without risking SIGSEGV, so PR_SET_NAME always fails with EFAULT
+// (arg2 is never dereferenced). Every other option fails with ENOSYS.
+#define PR_SET_NAME 15
+static inline int prctl(int option, unsigned long, unsigned long, unsigned long,
+                        unsigned long) {
+    errno = (option == PR_SET_NAME) ? EFAULT : ENOSYS;
+    return -1;
+}
+
+// Linux capabilities: no Darwin equivalent. The types keep the JNI glue
+// compiling; capget/capset always fail with ENOSYS.
+struct __user_cap_header_struct {
+    uint32_t version;
+    int pid;
+};
+struct __user_cap_data_struct {
+    uint32_t effective;
+    uint32_t permitted;
+    uint32_t inheritable;
+};
+static inline int capget(__user_cap_header_struct*, __user_cap_data_struct*) {
+    errno = ENOSYS;
+    return -1;
+}
+static inline int capset(__user_cap_header_struct*, const __user_cap_data_struct*) {
+    errno = ENOSYS;
+    return -1;
+}
+
+// Linux-signature extended attribute calls (path variants follow symlinks,
+// like Linux). Darwin's take an extra position argument (resource forks only)
+// and an options word; these C++ overloads differ in arity from the SDK's.
+// Flags for setxattr are passed through: Java reads XATTR_CREATE/REPLACE from
+// OsConstants, which carries the Darwin values.
+// A missing attribute is ENOATTR (93) on Darwin but ENODATA on Linux, and Java
+// callers compare against OsConstants.ENODATA (Darwin's ENODATA, 96), so
+// ENOATTR is reported as ENODATA.
+static inline void shiraz_darwin_xattr_errno() {
+    if (errno == ENOATTR) {
+        errno = ENODATA;
+    }
+}
+static inline ssize_t getxattr(const char* path, const char* name, void* value, size_t size) {
+    ssize_t rc = getxattr(path, name, value, size, 0, 0);
+    if (rc == -1) shiraz_darwin_xattr_errno();
+    return rc;
+}
+static inline ssize_t listxattr(const char* path, char* list, size_t size) {
+    ssize_t rc = listxattr(path, list, size, 0);
+    if (rc == -1) shiraz_darwin_xattr_errno();
+    return rc;
+}
+static inline int removexattr(const char* path, const char* name) {
+    int rc = removexattr(path, name, 0);
+    if (rc == -1) shiraz_darwin_xattr_errno();
+    return rc;
+}
+static inline int setxattr(const char* path, const char* name, const void* value, size_t size,
+                           int flags) {
+    int rc = setxattr(path, name, value, size, 0, flags);
+    if (rc == -1) shiraz_darwin_xattr_errno();
+    return rc;
+}
+
+// SO_PEERCRED's struct ucred. Darwin reports peer credentials of AF_UNIX
+// sockets through LOCAL_PEERCRED (struct xucred) and LOCAL_PEERPID instead.
+struct ucred {
+    pid_t pid;
+    uid_t uid;
+    gid_t gid;
+};
+
+#endif  // PORTABILITY_DARWIN_H_included
