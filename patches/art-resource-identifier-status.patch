 }
+
+// Unlike the legacy wrapper, distinguish a confirmed miss from incomplete I/O.
+extern "C" bool AssetManager_findResourceId(struct AssetManager *asset_manager,
+                                           const char *name, const char *type,
+                                           const char *package, uint32_t *out_id) {
+  if (!asset_manager || !name || !type || !package || !out_id) return false;
+  auto manager = reinterpret_cast<GuardedAssetManager2 *>(asset_manager);
+  auto result = manager->GetResourceId(name, type, package);
+  *out_id = result.has_value() ? result.value() : 0;
+  return !android::IsIOError(result);
+}
